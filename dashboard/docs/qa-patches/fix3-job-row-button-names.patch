From 2945a60311401253aabb20320904b4d05db3c711 Mon Sep 17 00:00:00 2001
From: qa <qa@example.com>
Date: Mon, 9 Nov 2026 21:51:24 +0000
Subject: [PATCH] Job rows: action buttons carry the job title so screen-reader
 users can tell them apart

Save, Not for me and Open details had the same accessible name on every row (150 identical names on a 50-row page). The job title is now part of each name; a check in the
release's read-only browser test fails on the old build.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XXgLH6WFtkYDkV2ANeWeZ8
---
 dashboard/frontend/src/components/JobTable.tsx | 6 +++---
 dashboard/test/e2e/production-readonly.e2e.mjs | 2 ++
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/dashboard/frontend/src/components/JobTable.tsx b/dashboard/frontend/src/components/JobTable.tsx
index 7742c77..dcc505b 100644
--- a/dashboard/frontend/src/components/JobTable.tsx
+++ b/dashboard/frontend/src/components/JobTable.tsx
@@ -187,17 +187,17 @@ export const JobTable: React.FC<JobTableProps> = ({
                     <p className="text-xs text-slate-600 mt-1.5 line-clamp-2" data-testid="job-why">{whyText(job.qualification_reason)}</p>
                   </div>
                   <div className="shrink-0 flex flex-col sm:flex-row items-center gap-1.5" onClick={(e) => e.stopPropagation()}>
-                    <button onClick={(e) => onSaveJob(job.id, e)} aria-label={isSaved ? 'Saved' : 'Save this job'} title={isSaved ? 'Saved' : 'Save this job'}
+                    <button onClick={(e) => onSaveJob(job.id, e)} aria-label={`${isSaved ? 'Saved' : 'Save this job'}: ${job.title}`} title={isSaved ? 'Saved' : 'Save this job'}
                       className={`min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg border transition-colors ${isSaved ? 'bg-amber-50 border-amber-300 text-amber-600' : 'bg-white border-slate-200 text-slate-500 hover:text-slate-800'}`}>
                       <Bookmark className="w-4 h-4" fill={isSaved ? 'currentColor' : 'none'} />
                     </button>
                     {onDismissJob && (
-                      <button onClick={(e) => onDismissJob(job.id, e)} aria-label="Not for me (hide this job)" title="Not for me (hide this job)"
+                      <button onClick={(e) => onDismissJob(job.id, e)} aria-label={`Not for me (hide this job): ${job.title}`} title="Not for me (hide this job)"
                         className="min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 hover:text-rose-600 hover:border-rose-200">
                         <XCircle className="w-4 h-4" />
                       </button>
                     )}
-                    <button onClick={() => onSelectJob(job)} aria-label="Open details" title="Open details"
+                    <button onClick={() => onSelectJob(job)} aria-label={`Open details: ${job.title}`} title="Open details"
                       className="min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-600">
                       <ChevronRight className="w-4 h-4" />
                     </button>
diff --git a/dashboard/test/e2e/production-readonly.e2e.mjs b/dashboard/test/e2e/production-readonly.e2e.mjs
index 8aba833..c164b4f 100644
--- a/dashboard/test/e2e/production-readonly.e2e.mjs
+++ b/dashboard/test/e2e/production-readonly.e2e.mjs
@@ -71,6 +71,8 @@ for (const [btn, cid, label, other] of [['FARHAN', 'farhan_shaikh', overview.far
   for (let i = 0; i < 20 && readCard(t) !== sc.READY; i++) { await page.waitForTimeout(1000); t = await text(); }
   const card = readCard(t);
   check(`${btn}: workspace heading and READY card match the API`, new RegExp(label + ' Workspace', 'i').test(t) && !new RegExp(other + ' Workspace', 'i').test(t) && card === sc.READY, `${card} vs ${sc.READY}`);
+  const rowButtons = await page.$$eval('[data-job-id] button[aria-label]', (els) => els.map((e) => e.getAttribute('aria-label')));   // a screen-reader user must be able to tell the rows apart
+  check(`${btn}: job-row buttons have names that tell the rows apart`, rowButtons.length > 0 && new Set(rowButtons).size === rowButtons.length, `${rowButtons.length} buttons, e.g. ${rowButtons.slice(0, 2).join(' | ')}`);
   await tab('Analytics');
   const ta = await text();
   check(`${btn}: Analytics is scoped to this candidate`, new RegExp('Current inventory for ' + (cid === 'sana_ansari' ? 'Sana' : 'Farhan')).test(ta) && !(cid === 'sana_ansari' ? /Farhan has/ : /Sana has/).test(ta));
